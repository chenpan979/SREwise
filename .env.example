# ============================================
# SREwise 环境变量配置模板
# ============================================
# 使用说明: 复制此文件为 .env，然后填入真实的配置值

# ============================================
# 阿里云 LLM (必填)
# ============================================
# 获取地址: https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max

# ============================================
# Neo4j (故障知识图谱)
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sredemo123

# ============================================
# Milvus (向量库)
# ============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ============================================
# Langfuse (可观测性，可选)
# ============================================
# 首次使用需在 http://localhost:3000 注册，获取 PK/SK
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENVIRONMENT=dev

# ============================================
# MCP 服务器端口 (通常不需要修改)
# ============================================
MCP_CLS_PORT=8003
MCP_MONITOR_PORT=8004
MCP_K8S_PORT=8005
MCP_ALERTMANAGER_PORT=8006
MCP_GRAFANA_PORT=8007

# ============================================
# 应用配置
# ============================================
APP_NAME=SREwise
APP_VERSION=2.0.0
LOG_LEVEL=INFO
