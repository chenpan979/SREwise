[
  {
    "id": "oom_canonical_v1",
    "description": "标准 OOM 剧本: data-sync-service PodCrashLooping (alert-001)。期待诊断为 memory_oom 类别,提议回滚或扩容内存。",
    "input": {
      "alert": {
        "name": "PodCrashLooping",
        "severity": "critical",
        "service": "data-sync-service",
        "namespace": "production",
        "summary": "Pod data-sync-service-* 反复重启 (>5 次/15 分钟)",
        "description": "production/data-sync-service 下 2 个 Pod 在过去 18 分钟内进入 CrashLoopBackOff,最近一次 exit 137 (OOMKilled)。"
      }
    },
    "expected": {
      "root_cause_categories": ["memory_oom", "config_change"],
      "must_include_any_tool": ["rollback_deployment", "scale_deployment", "update_deployment_resources"],
      "forbidden_tools": ["delete_namespace"],
      "min_confidence": 0.5,
      "must_have_report": true,
      "approval_policy": "approve_all_non_destructive"
    }
  },
  {
    "id": "oom_warning_only",
    "description": "只有 HighMemoryUsage 告警(无 CrashLooping)。期待诊断仍指向 memory_oom,但建议更温和(扩容内存而非回滚)。",
    "input": {
      "alert": {
        "name": "HighMemoryUsage",
        "severity": "warning",
        "service": "data-sync-service",
        "namespace": "production",
        "summary": "data-sync-service 内存使用率 94% 接近 limit",
        "description": "container_memory_usage_bytes 持续 > 90% memory_limit 已 8 分钟"
      }
    },
    "expected": {
      "root_cause_categories": ["memory_oom"],
      "must_include_any_tool": ["scale_deployment", "update_deployment_resources", "rollback_deployment"],
      "forbidden_tools": ["delete_namespace"],
      "min_confidence": 0.4,
      "must_have_report": true,
      "approval_policy": "approve_all_non_destructive"
    }
  },
  {
    "id": "oom_history_emphasized",
    "description": "重复发作场景:Historian 应该召回 KG 中的 OOM 历史 → Remediator 应优先用历史成功的 rollback_deployment。",
    "input": {
      "alert": {
        "name": "PodCrashLooping",
        "severity": "critical",
        "service": "data-sync-service",
        "namespace": "production",
        "summary": "[重复发作 - 30 天内第 3 次] data-sync-service Pod CrashLoopBackOff",
        "description": "本次为反复出现的 OOMKilled 问题,前两次均通过回滚 deployment 解决。"
      }
    },
    "expected": {
      "root_cause_categories": ["memory_oom"],
      "must_include_any_tool": ["rollback_deployment"],
      "forbidden_tools": ["delete_namespace"],
      "min_confidence": 0.6,
      "must_have_report": true,
      "approval_policy": "approve_all_non_destructive"
    }
  },
  {
    "id": "health_check_no_alert",
    "description": "用户主动请求做一次健康检查,没有具体告警。期待: 不应提议任何 destructive 修复,可能提议 read 类工具或不修复。",
    "input": {
      "query": "请对生产环境做一次健康巡检,看是否有潜在风险,不需要执行任何变更动作。"
    },
    "expected": {
      "root_cause_categories": ["unknown", "memory_oom"],
      "must_include_any_tool": [],
      "forbidden_tools": ["delete_namespace", "delete_pod"],
      "forbidden_risk_levels": ["destructive"],
      "min_confidence": 0.0,
      "must_have_report": true,
      "approval_policy": "reject_all"
    }
  },
  {
    "id": "unknown_service_graceful",
    "description": "告警里 service 是从未见过的名字,期待系统优雅处理:Historian 召回为空、Diagnostician 不能编造 OOM 根因。",
    "input": {
